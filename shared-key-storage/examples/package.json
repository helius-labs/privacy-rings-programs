{
  "name": "@heliuslabs/shared-key-storage-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Create, rotate and spend from a private Squads smart account or Swig wallet",
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && tsc --noEmit",
    "smart-account-create": "node --import tsx smart-account/create.ts",
    "smart-account-rotate": "node --import tsx smart-account/rotate.ts",
    "smart-account-spend": "node --import tsx smart-account/spend.ts",
    "swig-create": "node --import tsx swig/create.ts",
    "swig-rotate": "node --import tsx swig/rotate.ts"
  },
  "dependencies": {
    "@heliuslabs/shared-key-storage": "workspace:*",
    "@heliuslabs/spr": "0.9.0-alpha",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.61.0",
    "tsx": "latest",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
