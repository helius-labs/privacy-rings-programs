{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "smart-account/*.ts",
    "swig/*.ts",
    "helpers/**/*.ts",
    "test/**/*.ts"
  ]
}
