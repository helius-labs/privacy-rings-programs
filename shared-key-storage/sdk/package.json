{
  "name": "@heliuslabs/shared-key-storage",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Shared Key Storage on the SPL Record program, for private Squads smart accounts and Swig wallets",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "oxfmt --check . && tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test test/*.test.ts test/record/*.test.ts test/smart-account/*.test.ts test/swig/*.test.ts",
    "test:devnet": "SA_NETWORK=devnet node --import tsx --test --test-concurrency=1 test/network/*.test.ts",
    "test:mainnet": "SA_NETWORK=mainnet node --import tsx --test --test-concurrency=1 test/network/*.test.ts"
  },
  "devDependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@solana/kit": "^8.3.0",
    "@types/node": "^24.0.0",
    "litesvm": "1.6.2",
    "oxfmt": "^0.61.0",
    "tsx": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@solana/kit": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
